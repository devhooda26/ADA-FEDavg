{
  "version": "2.0.0",
  "tasks": [
    { "label": "Setup (first time)", "type": "npm", "script": "setup", "problemMatcher": [], "detail": "Create .env, Python venv, download NSL-KDD" },
    { "label": "Doctor (check environment)", "type": "npm", "script": "doctor", "problemMatcher": [] },
    {
      "label": "Start dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": { "owner": "ada", "pattern": { "regexp": "^$" }, "background": { "activeOnStart": true, "beginsPattern": "^$", "endsPattern": "ADA-FedAvg is running" } },
      "group": { "kind": "build", "isDefault": true }
    },
    { "label": "Run all checks (lint + tests)", "type": "npm", "script": "verify", "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
    { "label": "Run API tests", "type": "npm", "script": "test", "group": "test", "problemMatcher": [] },
    { "label": "Run ML tests", "type": "npm", "script": "test:ml", "group": "test", "problemMatcher": [] },
    { "label": "Docker: build and start", "type": "npm", "script": "docker:up", "problemMatcher": [] }
  ]
}
