{
  "name": "ADA-FedAvg",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": { "ghcr.io/devcontainers/features/python:1": { "version": "3.12" } },
  "forwardPorts": [4000],
  "portsAttributes": { "4000": { "label": "ADA-FedAvg", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "npm ci && npm run setup",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "editorconfig.editorconfig", "humao.rest-client"],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" }
    }
  },
  "remoteEnv": { "HOST": "0.0.0.0" }
}
