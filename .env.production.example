# Copy to .env on the server. Never commit .env.
DOMAIN=ada.example.com
APP_URL=https://ada.example.com
# Same origin as the site, so no extra CORS origins are needed
CORS_ORIGINS=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_TTL_HOURS=12
# Real email (required for verification/reset to reach users), e.g. smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM=ADA-FedAvg <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=true
