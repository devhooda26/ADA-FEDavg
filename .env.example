PORT=4000
# 0.0.0.0 = reachable from VS Code port forwarding, Docker and other devices on your network. Use 127.0.0.1 to restrict to this machine.
HOST=0.0.0.0
# The UI is served by this same server (same origin), so this is normally just the site URL.
# Add more origins (comma-separated) only if you host a separate frontend.
CORS_ORIGINS=http://localhost:4000
DB_PATH=./data/app.db
NODE_ENV=development
# Initial admin. If ADMIN_PASSWORD is empty, a random one is generated and printed ONCE on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# Public URL used in emailed links
APP_URL=http://localhost:4000
# Email: set SMTP_URL (e.g. smtps://user:pass@smtp.example.com) for real delivery.
# Without it, emails go to the server console + an admin-only outbox (development only).
SMTP_URL=
MAIL_FROM=ADA-FedAvg <no-reply@example.com>
# true = users must verify email before they can sign in (use with SMTP_URL)
REQUIRE_EMAIL_VERIFICATION=false
# Python interpreter that has numpy + scikit-learn. `npm run setup` points this at ./.venv automatically.
PYTHON=python3
# Maximum CSV upload size in MB, and where uploads are stored
MAX_UPLOAD_MB=50
# UPLOAD_DIR=./data/uploads
# Where trained models are kept for the Detect tab (default ./data/models)
# MODELS_DIR=./data/models
